{
  "overrides": [
    {
      "files": [
        "**/__test{,s}__/**/*.{js,jsx,ts,tsx}",
        "**/{test{,s},mock{,s}}/**/*.{js,jsx,ts,tsx}",
        "**/*.{test,spec}.{js,jsx,ts,tsx}"
      ],
      "plugins": [
        "unicorn",
        "typescript",
        "oxc",
        "import",
        "vitest"
      ],
      "env": {
        "browser": true,
        "builtin": true,
        "vitest": true
      }
    }
  ]
}
